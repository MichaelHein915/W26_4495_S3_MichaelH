hcloud_token          = "YOUR_HETZNER_CLOUD_TOKEN"
existing_ssh_key_name = "YOUR_EXISTING_HETZNER_SSH_KEY_NAME"
location              = "nbg1"
domain                = "placeholder.example.com"

# Paste the full public key contents, e.g. from ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAA... your-email@example.com"
