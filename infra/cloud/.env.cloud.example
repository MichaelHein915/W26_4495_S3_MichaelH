APP_ENV=cloud
LOG_LEVEL=INFO

# ── Public entrypoint ─────────────────────────────────────────────────────────
# First deploy: use the server IP over plain HTTP
#   SITE_ADDRESS=:80
#   PUBLIC_BASE_URL=http://YOUR_DATA_VM_PUBLIC_IP
#
# Later, once you have a domain or nip.io hostname:
#   SITE_ADDRESS=YOUR_DOMAIN_OR_NIP_IO_HOST
#   PUBLIC_BASE_URL=https://YOUR_DOMAIN_OR_NIP_IO_HOST
SITE_ADDRESS=:80
PUBLIC_BASE_URL=http://YOUR_DATA_VM_PUBLIC_IP

# ── Coinbase WebSocket ────────────────────────────────────────────────────────
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
CRYPTO_SYMBOLS=BTC-USD,ETH-USD,SOL-USD,XRP-USD,ADA-USD,DOGE-USD,AVAX-USD,LINK-USD,LTC-USD,BCH-USD

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=10.0.1.10:9092
KAFKA_CLIENT_ID=crypto-producer-cloud
KAFKA_TOPIC_RAW=crypto.trades.raw.v1
KAFKA_TOPIC_CANDLES=crypto.candles.1m.v1
KAFKA_TOPIC_METRICS=crypto.metrics.live.v1
KAFKA_TOPIC_ALERTS=crypto.alerts.v1
KAFKA_FAIL_ON_DATA_LOSS=false
# Generate with: docker run --rm apache/kafka:3.7.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=CHANGE_ME_GENERATE_A_UUID

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=10.0.1.20
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=crypto
CLICKHOUSE_USER=crypto_writer
CLICKHOUSE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Storage paths (on attached volumes) ───────────────────────────────────────
CHECKPOINT_DIR=/data/checkpoints
