KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_RAW=crypto.trades.raw
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
CRYPTO_SYMBOLS=BTC-USD,ETH-USD,SOL-USD,XRP-USD,ADA-USD,DOGE-USD,AVAX-USD,LINK-USD,LTC-USD,BCH-USD
LOG_LEVEL=INFO
KAFKA_CLIENT_ID=crypto-producer

# Multi-exchange producer (coinbase, binance, kraken)
EXCHANGES=coinbase,binance,kraken
BINANCE_WS_URL=wss://stream.binance.com:9443
KRAKEN_WS_URL=wss://ws.kraken.com/v2

CHECKPOINT_DIR=data/checkpoints/raw_console
SPARK_LOG_LEVEL=WARN
PRODUCER_LOG_LEVEL=INFO

# Amazon Redshift Serverless (run setup_aws.sh to create)
REDSHIFT_HOST=<workgroup-name>.<account-id>.ca-west-1.redshift-serverless.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=crypto
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=<your-password>
REDSHIFT_IAM_ROLE=arn:aws:iam::<account-id>:role/RedshiftS3ReadRole

# S3 + Athena
S3_BUCKET=crypto-pipeline-staging-<account-id>
S3_STAGING_PREFIX=crypto-data/
AWS_REGION=ca-west-1
ATHENA_DATABASE=crypto_pipeline

# QuickSight
QUICKSIGHT_USER=<your-quicksight-username>

# Redshift Sink Tuning
SINK_FLUSH_INTERVAL_SEC=60
SINK_FLUSH_MAX_RECORDS=5000

# Alerts (Slack and/or email for arbitrage & volume spike notifications)
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_ARBITRAGE_THRESHOLD_PCT=0.3
ALERT_VOLUME_SPIKE_RATIO=2.0
# Price threshold alerts: SYMBOL:above|below:PRICE (comma-separated for multiple)
# Example: Alert when BTC >= $100000, ETH <= $3000
# ALERT_PRICE_THRESHOLDS=BTC-USD:above:100000,ETH-USD:below:3000
ALERT_PRICE_THRESHOLDS=

# ML anomaly detection (Isolation Forest on trade_count, volatility, volume, price_change)
ALERT_ANOMALY_ENABLED=true
ANOMALY_CONTAMINATION=0.05
