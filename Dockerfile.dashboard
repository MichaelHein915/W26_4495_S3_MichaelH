# Flask dashboard API + static frontend
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ src/
COPY config/ config/
COPY Implementation/dashboard/ Implementation/dashboard/

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1
ENV DASHBOARD_PORT=5000

EXPOSE 5000

CMD ["python", "Implementation/dashboard/api_server.py"]
